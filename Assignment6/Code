###2 Part 2: Take-Home (Staggered DiD with the did Package)

data(mpdta)

#-------------------------------------------------------------------------------

##2.1 Data structure and visualization

#a)
n_distinct(mpdta$countyreal)
#500 

n_distinct(mpdta$first.treat)
#4

table(mpdta$first.treat)
# 0:1545, 2004:100, 2006:200, 2007:655

#"Staggered treatment adoption" means that counties do not all receive treatment
#at the same time. Some counties are treated in 2004, in 2006,in 2007, and some 
#are never treated. 

#b)
mpdta_avg <- mpdta %>%
  mutate(
    cohort = factor(
      first.treat,
      levels = c(0, 2004, 2006, 2007),
      labels = c("Never treated", "Adopted 2004", "Adopted 2006", "Adopted 2007")
    )
  ) %>%
  group_by(year, cohort) %>%
  summarise(mean_lemp = mean(lemp, na.rm = TRUE), .groups = "drop")


p <- ggplot(mpdta_avg, aes(x = year, y = mean_lemp, color = cohort, group = cohort)) +
  geom_line(linewidth = 1) +
  geom_point(size = 2) +
  theme_minimal() +
  labs(
    title = "Average Log Teen Employment by Treatment Cohort",
    x = "Year",
    y = "Log teen employment",
    color = "Treatment cohort"
  )
p

ggsave(
  filename = "mpdta_cohort_trends.png",
  plot = p,
  width = 8,
  height = 5,
  dpi = 300
)
#The cohorts follow similar trends before their respective treatment years. 
#However, the level of the cohorts are different. After treatment, there is no immediate 
#visible effect for treated cohorts relative to others. The changes are gradual and 
#similar across cohorts.

#-------------------------------------------------------------------------------

##2.2 Naive TWFE vs. Callaway-Sant´anna estimator

#a)
mpdta = mpdta %>%
  mutate(treated_post = as.integer(first.treat > 0 & year >= first.treat))
m_twfe = feols(lemp ~ treated_post | countyreal + year,
               data = mpdta, cluster = ~countyreal)
summary(m_twfe)

#The coefficient on treated_post is -0.0365. That means that, the treatment is associated 
#with a decrease in 3,65% teen employment.

#b)
cs_out = att_gt(
  yname = "lemp",
  gname = "first.treat",
  idname = "countyreal",
  tname = "year",
  xformla = ~ lpop,
  data = mpdta,
  control_group = "nevertreated")
# Aggregate to an overall ATT
aggte(cs_out, type = "simple")

#The overall ATT estimate is -0.0418. This suggests that the treatment reduces teen 
#employment by approximately 4.18% on average.

#c)
cs_dyn <- aggte(cs_out, type = "dynamic")
p_dyn <- ggdid(cs_dyn)
p_dyn

ggsave(
  filename = "event_study_cs.png",
  plot = p_dyn,
  width = 8,
  height = 5,
  dpi = 300
)

#The confidence intervals of the pre-treatment estimates all include zero, 
#meaning that there are no statistically significant differences in trends before treatment. 
#Therefore, the parallel trends assumption appears plausible.
#The post-treatment estimates show a clear negative pattern. 
#While the immediate effect at t = 0 is small and not statistically significant,
#the estimates become more negative over time. Indicating that the treatment has 
#a negative and growing impact on teen employment over time.

#-------------------------------------------------------------------------------

##2.3 Pre-testing the parallel trends assumption

#a)
cs_out_bt = att_gt(
  yname = "lemp",
  gname = "first.treat",
  idname = "countyreal",
  tname = "year",
  xformla = ~ lpop,
  data = mpdta,
  control_group = "nevertreated",
  bstrap = TRUE,
  cband = TRUE)
summary(cs_out_bt)

#The p-value is 0.233.
#The null hypothesis is; all pre-treatment effects are zero.
#Since the p-value is relatively big, we fail to reject the null hypothesis.

#b)
ggdid(cs_out_bt)
ggsave("mpdta_att_gt.pdf", width = 10, height = 6)

#All pre-treatment ATT(g,t) estimates include 0 in their confidence interval

#c)
#Failing to reject the pre-test only indicates that we do not find evidence of 
#differences in the pre-treatment period. The test cannot rule out violations 
#that occur after treatment or differences that are not detected statistically.
#Therefore, it provides no certain evidence for the parallel trends assumption.

#-------------------------------------------------------------------------------

##2.4 Comparing control group specifications

#a)
cs_out_nyt = att_gt(
  yname = "lemp",
  gname = "first.treat",
  idname = "countyreal",
  tname = "year",
  xformla = ~ lpop,
  data = mpdta,
  control_group = "notyettreated")
aggte(cs_out_nyt, type = "simple")

#The ATT using not-yet-treated counties is -0.0414. While the ATT using 
#never-treated counties (Section 2.2b) was -0.0418.
#The two estimates are almost identical in both sign and magnitude.

#b)
cs_dyn_nyt = aggte(cs_out_nyt, type = "dynamic")
ggdid(cs_dyn_nyt)
ggsave("mpdta_event_study_nyt.pdf", width = 7, height = 4)

#The results are similar to section 2.2c, the overall conclusion, the treatment
#reduces teen employment and the effect grows with time, remains unchanged.

#c)
#Never-treated as the control group is preferable when we are concerned about 
#anticipation effects. Not-yet-treated as the control group can improve precision 
#by increasing the number of control observations, but rely on the assumption that 
#future treatment does not affect current outcomes. Not-yet-treated controls are 
#preferable when anticipation effects are unlikely.

