###2 Part 2: Take-Home (Point Data and Spatial Joins)

events <- read.csv("C:/Users/carlo/OneDrive/Dokumente/AQMSS2/Assignment7/conflict_events.csv")

#-------------------------------------------------------------------------------

##2.1 Converting tabular data to sf

#a)
events_sf <- st_as_sf(
  events,
  coords = c("longitude", "latitude"),
  crs = 4326
)

class(events_sf)
st_crs(events_sf)

#st_as_sf() converts a regular data frame into an sf object.
#The coords argument tells R which columns contain the geographic coordinates.
#crs = 4326 assigns the coordinate reference system WGS84.

#b)
nrow(events_sf)
#68354

table(events_sf$event_type)
#stat-based is the most common with 33487.

#c)
world <- ne_countries(scale = "medium", returnclass = "sf")

p <- ggplot() +
  geom_sf(data = world, fill = "grey85", color = "white", linewidth = 0.2) +
  geom_sf(data = events_sf, aes(color = event_type), size = 1, alpha = 0.7) +
  theme_minimal() +
  labs(
    title = "Conflict Events Worldwide",
    subtitle = "Conflict events overlaid on world polygons",
    color = "Event type"
  )

p

ggsave("conflict_events_map.png", plot = p, width = 12, height = 7, dpi = 300)

#The map only shows events im Africa. The events are concentrated in the middle 
#of Africa. 

#-------------------------------------------------------------------------------

##2.2 Spatial join: events to countries

#a)
st_crs(events_sf)
st_crs(world)

world <- st_transform(world, st_crs(events_sf))

events_joined <- st_join(events_sf, world)

nrow(events_sf)
nrow(events_joined)

#Checking the CRS before joining is important because spatial coordinates only 
#line up correctly if both data sets use the same coordinate reference system.

#b)
sum(is.na(events_joined$name_long))

sum(is.na(events_joined$name_long)) / nrow(events_joined)
#0,0231

#A point might not match a polyglot, because the event is outside any country polyglots,
#or the point lies exactly on a border.

#c)
country_summary <- events_joined %>%
  filter(!is.na(name_long)) %>%
  group_by(name_long) %>%
  summarise(
    n_events = n(),
    total_fatalities = sum(fatalities, na.rm = TRUE)
  ) %>%
  arrange(desc(n_events))

country_summary %>%
  st_drop_geometry() %>%
  slice(1:10)

#Yes, the results are consistent with my knowledge on contemporary armed conflicts. 
#In the top 10 are countries like the Democratic Republic of Congo, Somalia, or Rwanda,
#which are unfortunately known for military conflicts. 

#-------------------------------------------------------------------------------

##2.3 Choropleth of conflict intensity

#a)
country_counts <- country_summary %>%
  st_drop_geometry()

world_conflict <- world %>%
  left_join(country_counts, by = c("name_long" = "name_long")) %>%
  mutate(
    n_events = replace_na(n_events, 0),
    total_fatalities = replace_na(total_fatalities, 0)
  )

nrow(world)
nrow(world_conflict)

#b)
conflict_map <- ggplot(world_conflict) +
  geom_sf(aes(fill = n_events), color = "white", linewidth = 0.2) +
  scale_fill_distiller(palette = "Reds", direction = 1, name = "Events") +
  theme_minimal() +
  labs(
    title = "Conflict Event Counts by Country",
    subtitle = "Number of conflict events"
  )

conflict_map

ggsave("conflict_count_map.pdf", plot = conflict_map, width = 12, height = 7)

#Yes, the geographic pattern matches the event-level map from question 2.1c.

#c)
conflict_log_map <- ggplot(world_conflict) +
  geom_sf(aes(fill = log1p(n_events)), color = "white", linewidth = 0.2) +
  scale_fill_distiller(
    palette = "YlOrRd",
    direction = 1,
    name = "Log(events+1)"
  ) +
  theme_minimal() +
  labs(
    title = "Log-Transformed Conflict Event Counts by Country",
    subtitle = "Using log(events + 1)"
  )

conflict_log_map

ggsave("conflict_log_map.pdf", plot = conflict_log_map, width = 12, height = 7)

#The log transformation is useful because raw event counts are often highly skewed: 
#a small number of countries have very many events, while most countries have few or none.
#Using log reveals a broader range of countries with some conflict activity that 
#may not stand out on the raw count map.

