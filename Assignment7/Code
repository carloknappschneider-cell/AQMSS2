###1 Part 1: In-Class (Exploring Spatial Data with sf)

data(world)

#-------------------------------------------------------------------------------

##1.1 Inspecting an sf object

#a)
class(world)
names(world)
nrow(world)

#A sf object different from a regular R data frame due to a column called geometry.
#In the geometry collums all geometry types: POINT, LINESTRING, POLYGON and their
#multi-variants are stored. 
#sf saves all those geometry objects as vectors or matrics

#b)
st_crs(world)

#The dataset uses EPSG:4326 (WGS84 — World Geodetic System 1984). 
#It is the global standard because it provides the basis for GPS. Using a single 
#global system allows devices and software worldwide to communicate locations 
#using consistent Latitude and Longitude without regional offsets.

#c)
st_geometry_type(world)

unique(st_geometry_type(world))

#A MULTIPOLYGON is a collection of polygons treated as a single geographic feature. 
#Countries with multiple polyglons have not one singular land mass, but have several 
#territories, like an island or a an exclave.
#Examples: 1. Azerbaijan with the exclave Nakhchivan Autonomous Republic.
#2. Indonesia needs thousands of polyglons due to plenty of islands.


#d)
pdf("world_gdp_base.pdf")
plot(world["gdpPercap"])
dev.off()

plot(world["gdpPercap"], main = "GDP per capita by country")

#The global north and parts of the middle east appears to be richest, while 
#countries especially in Africa and parts of Asia seem poorest. 

#-------------------------------------------------------------------------------

##1.2 Attribute operations

#a)
africa = filter(world, continent == "Africa")
nrow(africa)

plot(africa["gdpPercap"], main = "GDP per capita -- Africa")

#No the country count is 51, but Africa has 54 recognize states. 

#b)
world = world %>%
  mutate(pop_millions = pop / 1e6)
gdp_by_continent = world %>%
  group_by(continent) %>%
  summarise(mean_gdpPercap = mean(gdpPercap, na.rm = TRUE))
print(st_drop_geometry(gdp_by_continent))

#When summarise() is called on a grouped sf object, it unions the geometries within
#each group and retains the resulting geometry column. To obtain a plain data frame 
#without spatial information, use st_drop_geometry() before or after the summary step. 
#This avoids carrying unneeded geometry through purely tabular analyses.

#c)
africa_sorted = africa %>%
  arrange(desc(gdpPercap)) %>%
  select(name_long, gdpPercap)
print(head(st_drop_geometry(africa_sorted), 5))
#The 5 African countries with the highest gdp pp. are: Equatorial Guinea, Gabon,
#Libya, Botswana, Algeria.

