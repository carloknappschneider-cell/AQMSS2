###2 Part 2: Take-Home (Survival Analysis)


lung <- survival::lung
lung$dead <- lung$status - 1

#-------------------------------------------------------------------------------

##2.1 Kaplan-Meier survival curves

#a)
nrow(lung)
sum(lung$dead == 1, na.rm = TRUE)
sum(lung$dead == 0, na.rm = TRUE)
sum(lung$dead == 0, na.rm = TRUE) / sum(lung$dead == 1, na.rm = TRUE)

#The total number of observations is 228.
#The number of events (deaths) is 165.
#The number of censored cases is 63, which is a approximately 38% of all patients,
#which seems like a fairly big share.

#b)
survfit(Surv(time, dead) ~ 1, data = lung)

km_fit <- survfit(Surv(time, dead) ~ 1, data = lung)
summary(km_fit)

#The estimated median survival time is 310 days.This means that 50% of the patients
#have died by around 310 days after enrollment, while the other 50% survived longer
#than this time.

#c)
km_sex <- survfit(Surv(time, dead) ~ sex, data = lung)

km_df <- tidy(km_sex)

km_df$sex <- factor(km_df$strata,
                    labels = c("Male", "Female"))

p <- ggplot(km_df, aes(x = time, y = estimate, color = sex, fill = sex)) +
  geom_step(size = 1) +
  geom_ribbon(aes(ymin = conf.low, ymax = conf.high), alpha = 0.2, color = NA) +
  labs(
    title = "Kaplan-Meier Survival Curves by Sex",
    x = "Time (days)",
    y = "Survival Probability",
    color = "Sex",
    fill = "Sex"
  ) +
  theme_minimal()

print(p)

ggsave("km_survival_by_sex.pdf", plot = p, width = 8, height = 6)

#The Kaplan-Maier curve clearly shows that female have a higher chance of survival
#at any given time and live therefore longer. The confidence intervals do sometimes
#overlap, nevertheless the trend appears to be systematic. 


survdiff(Surv(time, dead) ~ sex, data = lung)

#The log-rank p-value is p=0.001. 
#The log-rank test evaluates whether there is a difference in survival distributions
#between groups over time. A small p-value suggests that the survival experiences
#of males and females are significantly different.

#-------------------------------------------------------------------------------

##2.2 Cox proportional hazards model

#a)
cox_model <- coxph(Surv(time, dead) ~ age + sex + ph.ecog, data = lung)

summary(cox_model)

#The hazard ratio for sex is 0.575. This means that females have about 42.5% lower
#hazard of death compared to males. The results are statistically significant. 

#b)
#The hazard ratio for ph.ecog is 1.59. This means that a one unit increase in
#ECOG performance score leads to a 59% higher hazard of death.

#c)
ph_test <- cox.zph(cox_model)

ph_test

#All p-values are above 0.05, which indicates that there is no evidence against 
#the proportional hazards assumption. Therefore, the effects of age, sex, and ph.ecog
#are most likely constant over time.

#d)
#(1) The Kaplan-Meier analysis clearly suggest a survival difference between sexes,
#male have a substantially higher hazard rate. 
#(2) For the Cox model age is not significant. The predictor sex is significant and 
#has a negative effect which means that female have a higher chance of survival. 
#Ph.ecog is also significant and has a positive effect which means that for every 
#increase in ECOG performance score the hazard ratio increases as well. 
#(3) The proportional hazard assumption holds, as shown by the ph_test where no 
#predictor has a p value under 0.05.
#(4) The survival probability at a given time for a person is significantly influences
#by the sex of that person. If a person is a male the survival probability is lower.
#What ECOG performance score a person has also influences the hazard ratio.
#If a person has a higher ECOG performance score, the survival probability is lower as well.
